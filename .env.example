# ---- Supabase (Project Settings → API) ----
# Public: safe in the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-ONLY SECRET — never prefix with NEXT_PUBLIC_, never share
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ---- Site ----
# Your live address (Vercel URL now, custom domain later). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://ever-after-memoir.vercel.app

# Random string used to hash visitor IPs for rate limiting (any long random text)
INQUIRY_IP_SALT=change-me-to-a-long-random-string

# ---- Optional: email alert for new inquiries (resend.com) ----
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=
# Must be a verified sender in Resend, e.g. "Ever After Memoir <hello@yourdomain.com>"
RESEND_FROM=
