// Generates the starter-content SQL from src/lib/content/defaults.ts:
//   supabase/migrations/0002_seed.sql     — a fresh database
//   supabase/migrations/0004_refresh.sql  — upgrade a database seeded by an earlier version
//   supabase/migrations/0005_slots.sql    — day/night slots, new booking fields, new name and Malay text
// Run: npm run seed:generate
import { writeFileSync, statSync } from 'node:fs'
import { join } from 'node:path'
import {
  MEDIA_FILES, DEFAULT_PAGES, DEFAULT_STORIES, DEFAULT_SERVICES, DEFAULT_SOCIAL,
  DEFAULT_SETTINGS, DEFAULT_SETTINGS_ID, PAGE_IDS, RETIRED_MEDIA_IDS, DEFAULT_BOOKING_MESSAGE_MS, fileUrl,
  PREVIOUS_BOOKING_MESSAGE, PREVIOUS_BOOKING_MESSAGE_MS, PREVIOUS_TAGLINE_MS, PREVIOUS_SITE_TITLE,
} from '../src/lib/content/defaults.ts'

const q = (s: string) => `'${s.replace(/'/g, "''")}'`
const j = (o: unknown) => `${q(JSON.stringify(o))}::jsonb`
const root = new URL('..', import.meta.url).pathname
const mime = (f: string) => (f.endsWith('.mp4') ? 'video/mp4' : 'image/jpeg')

function mediaInserts(onConflict: string) {
  return MEDIA_FILES.map((f) => {
    const size = statSync(join(root, 'public/brand', f.file)).size
    const folder = f.isSample ? 'Samples' : f.type === 'video' ? 'Films' : 'Brand'
    return `insert into public.media_assets (id, url, type, mime, size_bytes, width, height, alt_text, folder, is_sample) values (${q(f.id)}, ${q(fileUrl(f.file))}, ${q(f.type)}, ${q(mime(f.file))}, ${size}, ${f.width}, ${f.height}, ${q(f.alt)}, ${q(folder)}, ${f.isSample}) ${onConflict};`
  })
}

const collections: [string, { id: string }[]][] = [
  ['stories', DEFAULT_STORIES],
  ['services', DEFAULT_SERVICES],
  ['social_items', DEFAULT_SOCIAL],
]

// ---------------------------------------------------------------------------
// 0002 — fresh install
// ---------------------------------------------------------------------------
{
  const lines: string[] = [
    '-- Ever After Memoir — starter content (generated by scripts/generate-seed.mts)',
    '-- Safe to re-run: existing rows are never overwritten.',
    '',
    '-- Media bundled with the website in /public/brand',
    ...mediaInserts('on conflict (id) do nothing'),
    '',
    '-- Pages',
  ]
  Object.entries(DEFAULT_PAGES).forEach(([slug, content], i) => {
    lines.push(
      `insert into public.pages (id, slug, status, draft, published, published_at, sort_order) values (${q(PAGE_IDS[slug as keyof typeof PAGE_IDS])}, ${q(slug)}, 'published', ${j(content)}, ${j(content)}, now(), ${i}) on conflict (slug) do nothing;`,
    )
  })
  lines.push('', '-- Website settings')
  lines.push(
    `insert into public.site_settings (id, status, draft, published, published_at) values (${q(DEFAULT_SETTINGS_ID)}, 'published', ${j(DEFAULT_SETTINGS)}, ${j(DEFAULT_SETTINGS)}, now()) on conflict (singleton) do nothing;`,
  )
  for (const [table, items] of collections) {
    lines.push('', `-- ${table}`)
    items.forEach(({ id, ...content }, i) => {
      lines.push(
        `insert into public.${table} (id, status, draft, published, published_at, sort_order) values (${q(id)}, 'published', ${j(content)}, ${j(content)}, now(), ${i}) on conflict (id) do nothing;`,
      )
    })
  }
  lines.push('')
  writeFileSync(join(root, 'supabase/migrations/0002_seed.sql'), lines.join('\n'))
  console.log('wrote 0002_seed.sql', lines.length, 'lines')
}

// ---------------------------------------------------------------------------
// 0004 — refresh starter content (version 4: real films, Bahasa Melayu)
// Rows the owner has never saved (updated_by is null) get the new content.
// Rows the owner has edited are kept as they are; settings only gain the Malay text.
// ---------------------------------------------------------------------------
{
  const lines: string[] = [
    '-- Ever After Memoir — content refresh for version 4 (generated by scripts/generate-seed.mts)',
    '-- Adds the real films and photos, the Bahasa Melayu text and the new homepage layout.',
    '-- Anything you have already edited and saved in the admin is left exactly as it is.',
    '-- Run after 0001, 0002 and 0003. Safe to run more than once.',
    '',
    'begin;',
    '',
    '-- New media files (updates the details of files that already exist)',
    ...mediaInserts(
      'on conflict (id) do update set url = excluded.url, type = excluded.type, mime = excluded.mime, size_bytes = excluded.size_bytes, width = excluded.width, height = excluded.height, folder = excluded.folder, is_sample = excluded.is_sample',
    ),
    '',
    '-- Remove the old slideshow film and reels (their files are no longer part of the website)',
    `delete from public.media_assets where id in (${RETIRED_MEDIA_IDS.map(q).join(', ')});`,
    '',
    '-- Pages you have not edited yet',
  ]
  Object.entries(DEFAULT_PAGES).forEach(([slug, content], i) => {
    const id = q(PAGE_IDS[slug as keyof typeof PAGE_IDS])
    lines.push(
      `insert into public.pages (id, slug, status, draft, published, published_at, sort_order) values (${id}, ${q(slug)}, 'published', ${j(content)}, ${j(content)}, now(), ${i}) on conflict (slug) do update set draft = excluded.draft, published = excluded.published, status = 'published', published_at = now() where public.pages.updated_by is null;`,
    )
  })
  lines.push('', '-- Website settings: replaced if never edited; otherwise only the Malay text is added')
  lines.push(
    `update public.site_settings set draft = ${j(DEFAULT_SETTINGS)}, published = ${j(DEFAULT_SETTINGS)}, status = 'published', published_at = now() where updated_by is null;`,
  )
  const ms = DEFAULT_SETTINGS.ms ?? {}
  for (const col of ['draft', 'published']) {
    lines.push(
      `update public.site_settings set ${col} = jsonb_set(${col}, '{ms}', ${j(ms)} || coalesce(${col}->'ms', '{}'::jsonb)) where updated_by is not null and ${col} is not null;`,
      `update public.site_settings set ${col} = jsonb_set(${col}, '{bookingMessage}', to_jsonb(${q(DEFAULT_SETTINGS.bookingMessage)}::text)) where updated_by is not null and ${col}->>'bookingMessage' = ${q(DEFAULT_BOOKING_MESSAGE_MS)};`,
    )
  }
  for (const [table, items] of collections) {
    lines.push('', `-- ${table} you have not edited yet`)
    items.forEach(({ id, ...content }, i) => {
      lines.push(
        `insert into public.${table} (id, status, draft, published, published_at, sort_order) values (${q(id)}, 'published', ${j(content)}, ${j(content)}, now(), ${i}) on conflict (id) do update set draft = excluded.draft, published = excluded.published, status = 'published', published_at = now(), sort_order = excluded.sort_order where public.${table}.updated_by is null;`,
      )
    })
  }
  lines.push('', 'commit;', '')
  writeFileSync(join(root, 'supabase/migrations/0004_refresh.sql'), lines.join('\n'))
  console.log('wrote 0004_refresh.sql', lines.length, 'lines')
}

// ---------------------------------------------------------------------------
// 0005 — day/night slots, shorter booking form, everafter.memoir, natural Malay
// ---------------------------------------------------------------------------
{
  const ms = DEFAULT_SETTINGS.ms ?? {}
  const lines: string[] = [
    '-- everafter.memoir — version 5 (generated by scripts/generate-seed.mts)',
    '-- * Each date now has two slots: day and night.',
    '-- * Bookings ask for name, location, cover time and the couple’s Instagram.',
    '-- * The name becomes "everafter.memoir" and the Malay text is rewritten.',
    '-- Anything you have edited and saved yourself is kept. Run after 0001–0004. Safe to run more than once.',
    '',
    'begin;',
    '',
    '-- Slots. A date with status "limited" and a slot has that slot taken; "booked" means both are taken.',
    'alter table public.availability add column if not exists slot text;',
    'alter table public.availability drop constraint if exists availability_slot_check;',
    "alter table public.availability add constraint availability_slot_check check (slot is null or slot in ('day', 'night'));",
    'grant select (slot) on table public.availability to anon;',
    '',
    '-- New booking details',
    "alter table public.inquiries add column if not exists slot text not null default '';",
    "alter table public.inquiries add column if not exists cover_time text not null default '';",
    "alter table public.inquiries add column if not exists instagram text not null default '';",
    'alter table public.inquiries drop constraint if exists inquiries_slot_check;',
    "alter table public.inquiries add constraint inquiries_slot_check check (slot in ('', 'day', 'night'));",
    'alter table public.inquiries drop constraint if exists inquiries_cover_time_check;',
    'alter table public.inquiries add constraint inquiries_cover_time_check check (char_length(cover_time) <= 80);',
    'alter table public.inquiries drop constraint if exists inquiries_instagram_check;',
    'alter table public.inquiries add constraint inquiries_instagram_check check (char_length(instagram) <= 120);',
    '',
    '-- Pages you have not edited yet',
  ]
  Object.entries(DEFAULT_PAGES).forEach(([slug, content], i) => {
    const id = q(PAGE_IDS[slug as keyof typeof PAGE_IDS])
    lines.push(
      `insert into public.pages (id, slug, status, draft, published, published_at, sort_order) values (${id}, ${q(slug)}, 'published', ${j(content)}, ${j(content)}, now(), ${i}) on conflict (slug) do update set draft = excluded.draft, published = excluded.published, status = 'published', published_at = now() where public.pages.updated_by is null;`,
    )
  })
  lines.push('', '-- Website settings: replaced if never edited. Otherwise only values still at the old default change.')
  lines.push(
    `update public.site_settings set draft = ${j(DEFAULT_SETTINGS)}, published = ${j(DEFAULT_SETTINGS)}, status = 'published', published_at = now() where updated_by is null;`,
  )
  for (const col of ['draft', 'published']) {
    const w = `updated_by is not null and ${col} is not null`
    lines.push(
      `update public.site_settings set ${col} = jsonb_set(${col}, '{siteTitle}', to_jsonb(${q(DEFAULT_SETTINGS.siteTitle)}::text)) where ${w} and ${col}->>'siteTitle' = ${q(PREVIOUS_SITE_TITLE)};`,
      `update public.site_settings set ${col} = jsonb_set(${col}, '{bookingMessage}', to_jsonb(${q(DEFAULT_SETTINGS.bookingMessage)}::text)) where ${w} and ${col}->>'bookingMessage' in (${q(PREVIOUS_BOOKING_MESSAGE)}, ${q(PREVIOUS_BOOKING_MESSAGE_MS)});`,
      `update public.site_settings set ${col} = jsonb_set(${col}, '{ms}', coalesce(${col}->'ms', '{}'::jsonb) || ${j(ms)}) where ${w} and coalesce(${col}->'ms'->>'tagline', ${q(PREVIOUS_TAGLINE_MS)}) = ${q(PREVIOUS_TAGLINE_MS)};`,
    )
  }
  for (const [table, items] of collections) {
    lines.push('', `-- ${table} you have not edited yet`)
    items.forEach(({ id, ...content }, i) => {
      lines.push(
        `insert into public.${table} (id, status, draft, published, published_at, sort_order) values (${q(id)}, 'published', ${j(content)}, ${j(content)}, now(), ${i}) on conflict (id) do update set draft = excluded.draft, published = excluded.published, status = 'published', published_at = now(), sort_order = excluded.sort_order where public.${table}.updated_by is null;`,
      )
    })
  }
  lines.push('', "notify pgrst, 'reload schema';", '', 'commit;', '')
  writeFileSync(join(root, 'supabase/migrations/0005_slots.sql'), lines.join('\n'))
  console.log('wrote 0005_slots.sql', lines.length, 'lines')
}
