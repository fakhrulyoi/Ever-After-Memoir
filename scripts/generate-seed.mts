// Generates supabase/migrations/0002_seed.sql from src/lib/content/defaults.ts
// Run: node scripts/generate-seed.ts
import { writeFileSync, statSync } from 'node:fs'
import { join } from 'node:path'
import {
  SAMPLE_FILES, DEFAULT_PAGES, DEFAULT_STORIES, DEFAULT_SERVICES, DEFAULT_SOCIAL,
  DEFAULT_SETTINGS, DEFAULT_SETTINGS_ID, PAGE_IDS, sampleUrl,
} from '../src/lib/content/defaults.ts'

const q = (s: string) => `'${s.replace(/'/g, "''")}'`
const j = (o: unknown) => `${q(JSON.stringify(o))}::jsonb`
const root = new URL('..', import.meta.url).pathname
const lines: string[] = [
  '-- Ever After Memoir — starter content (generated by scripts/generate-seed.ts)',
  '-- Safe to re-run: existing rows are never overwritten.',
  '',
  '-- Sample media (bundled with the website in /public/samples)',
]
const mime = (f: string) => (f.endsWith('.mp4') ? 'video/mp4' : 'image/jpeg')
for (const f of SAMPLE_FILES) {
  const size = statSync(join(root, 'public/samples', f.file)).size
  lines.push(
    `insert into public.media_assets (id, url, type, mime, size_bytes, width, height, alt_text, folder, is_sample) values (${q(f.id)}, ${q(sampleUrl(f.file))}, ${q(f.type)}, ${q(mime(f.file))}, ${size}, ${f.width}, ${f.height}, ${q(f.alt)}, 'Samples', true) on conflict (id) do nothing;`,
  )
}
lines.push('', '-- Pages')
Object.entries(DEFAULT_PAGES).forEach(([slug, content], i) => {
  lines.push(
    `insert into public.pages (id, slug, status, draft, published, published_at, sort_order) values (${q(PAGE_IDS[slug as keyof typeof PAGE_IDS])}, ${q(slug)}, 'published', ${j(content)}, ${j(content)}, now(), ${i}) on conflict (slug) do nothing;`,
  )
})
lines.push('', '-- Website settings')
lines.push(
  `insert into public.site_settings (id, status, draft, published, published_at) values (${q(DEFAULT_SETTINGS_ID)}, 'published', ${j(DEFAULT_SETTINGS)}, ${j(DEFAULT_SETTINGS)}, now()) on conflict (singleton) do nothing;`,
)
const coll = (table: string, items: { id: string }[]) => {
  lines.push('', `-- ${table}`)
  items.forEach(({ id, ...content }, i) => {
    lines.push(
      `insert into public.${table} (id, status, draft, published, published_at, sort_order) values (${q(id)}, 'published', ${j(content)}, ${j(content)}, now(), ${i}) on conflict (id) do nothing;`,
    )
  })
}
coll('stories', DEFAULT_STORIES)
coll('services', DEFAULT_SERVICES)
coll('social_items', DEFAULT_SOCIAL)
lines.push('')
writeFileSync(join(root, 'supabase/migrations/0002_seed.sql'), lines.join('\n'))
console.log('wrote 0002_seed.sql', lines.length, 'lines')
